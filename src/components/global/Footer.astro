---
import LogoMark from './LogoMark.astro';
import { getLocaleFromPath, getPtBrCommon, type SiteLocale } from '../../lib/localization';

interface Props {
  locale?: SiteLocale;
}

const locale = Astro.props.locale || getLocaleFromPath(Astro.url.pathname);
const common = locale === 'pt-BR' ? getPtBrCommon() : null;
const footerCopy = common?.footer;

const englishDirectoryLinks = [
  { href: '/prompts/', label: 'All Prompts' },
  { href: '/categories/writing/', label: 'Writing Prompts' },
  { href: '/categories/coding/', label: 'Coding Prompts' },
  { href: '/categories/marketing/', label: 'Marketing Prompts' },
  { href: '/categories/image-generation/', label: 'Image Prompts' },
  { href: '/categories/business/', label: 'Business Prompts' },
];
const portugueseDirectoryLinks = [
  { href: '/pt-BR/', label: 'Início' },
  { href: '/pt-BR/best/best-ai-prompts/', label: 'Melhores prompts de IA' },
  { href: '/pt-BR/best/free-ai-prompts/', label: 'Prompts grátis' },
  { href: '/pt-BR/best/prompt-templates/', label: 'Modelos de prompts' },
  { href: '/pt-BR/best/gemini-prompts/', label: 'Prompts para Gemini' },
  { href: '/pt-BR/best/cursor-ai-prompts/', label: 'Prompts para Cursor' }
];
const directoryLinks = locale === 'pt-BR' ? portugueseDirectoryLinks : englishDirectoryLinks;

const englishResourceLinks = [
  { href: '/guides/', label: 'Guides' },
  { href: '/blog/', label: 'Blog' },
  { href: '/submit/', label: 'Submit a Prompt' },
];
const portugueseResourceLinks = [
  { href: '/pt-BR/prompts/ai-slop-remover/', label: 'Editor de texto de IA' },
  { href: '/pt-BR/prompts/business-plan-executive-summary/', label: 'Resumo de plano de negócios' },
  { href: '/submit/', label: 'Enviar um prompt (em inglês)' }
];
const resourceLinks = locale === 'pt-BR' ? portugueseResourceLinks : englishResourceLinks;

const englishBestPromptsLinks = [
  { href: '/best/', label: 'All Best-Of Lists' },
  { href: '/best/chatgpt-prompts/', label: 'Best ChatGPT Prompts' },
  { href: '/best/coding-prompts/', label: 'Best Coding Prompts' },
  { href: '/best/writing-prompts/', label: 'Best Writing Prompts' },
  { href: '/best/midjourney-prompts/', label: 'Best Midjourney Prompts' },
  { href: '/prompts/chatgpt/marketing/', label: 'ChatGPT Marketing Prompts' },
  { href: '/prompts/for/teachers/', label: 'AI Prompts for Teachers' },
  { href: '/best/dall-e-art-prompts/', label: 'DALL-E Prompts' },
  { href: '/best/prompt-templates/', label: 'Prompt Templates' },
  { href: '/prompts/cursor/coding/', label: 'Cursor Coding Prompts' },
];
const bestPromptsLinks = locale === 'pt-BR'
  ? portugueseDirectoryLinks.slice(1)
  : englishBestPromptsLinks;

const englishToolLinks = [
  { href: '/tools/chatgpt/', label: 'ChatGPT Prompts' },
  { href: '/tools/claude/', label: 'Claude Prompts' },
  { href: '/tools/midjourney/', label: 'Midjourney Prompts' },
  { href: '/tools/gemini/', label: 'Gemini Prompts' },
  { href: '/tools/cursor/', label: 'Cursor Prompts' },
];
const toolLinks = locale === 'pt-BR'
  ? [
      { href: '/pt-BR/best/gemini-prompts/', label: 'Prompts para Gemini' },
      { href: '/pt-BR/best/cursor-ai-prompts/', label: 'Prompts para Cursor' },
    ]
  : englishToolLinks;

const communityLinks = [
  { href: 'https://www.skool.com/ai-freedom-lab', label: 'AI Freedom Lab', external: true },
  { href: 'https://www.youtube.com/@AIHeavy', label: 'AI Heavy YouTube', external: true },
  { href: 'https://aitoolindex.io', label: 'AIToolIndex.io', external: true },
];

const englishCompanyLinks = [
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
  { href: '/privacy/', label: 'Privacy Policy' },
];
const companyLinks = locale === 'pt-BR'
  ? [
      { href: '/about/', label: 'Sobre (em inglês)' },
      { href: '/contact/', label: 'Contato (em inglês)' },
      { href: '/privacy/', label: 'Política de privacidade (em inglês)' },
    ]
  : englishCompanyLinks;
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-1)]">
  <div class="mx-auto max-w-7xl px-[var(--space-page)] py-16">
    <!-- Cross-promo -->
    <div class="mb-12 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6 text-center">
      <p class="text-sm text-[var(--color-text-secondary)]">
        {footerCopy?.crossPromoPrefix || 'Looking for AI tools? Visit'}
        <a href="https://aitoolindex.io" target="_blank" rel="noopener noreferrer" class="font-[var(--font-display)] font-semibold text-[var(--color-accent)] hover:underline">
          AIToolIndex.io
        </a>
        {footerCopy?.crossPromoSuffix || '— The AI Tools Directory'}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
      <!-- Directory -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.directory || 'Directory'}
        </h3>
        <ul class="space-y-2.5">
          {directoryLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.resources || 'Resources'}
        </h3>
        <ul class="space-y-2.5">
          {resourceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Best Prompts -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.bestPrompts || 'Best Prompts'}
        </h3>
        <ul class="space-y-2.5">
          {bestPromptsLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tools -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.byTool || 'By Tool'}
        </h3>
        <ul class="space-y-2.5">
          {toolLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Community -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.community || 'Community'}
        </h3>
        <ul class="space-y-2.5">
          {communityLinks.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h3 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
          {footerCopy?.company || 'Company'}
        </h3>
        <ul class="space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--color-border)] pt-8 sm:flex-row">
      <div class="flex items-center gap-2">
        <LogoMark size="sm" />
        <span class="font-[var(--font-display)] text-sm font-semibold text-[var(--color-text-primary)]">
          AIPromptIndex
        </span>
      </div>

      <p class="text-xs text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} AIPromptIndex. {footerCopy?.rights || 'All rights reserved.'}
      </p>

      <div class="flex items-center gap-3">
        <!-- Twitter / X -->
        <a href="https://twitter.com/aipromptindex" target="_blank" rel="noopener noreferrer" aria-label={footerCopy?.followX || 'Follow on X (Twitter)'} class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text-primary)]">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <!-- YouTube -->
        <a href="https://youtube.com/@AIHeavyOfficial" target="_blank" rel="noopener noreferrer" aria-label={footerCopy?.watchYoutube || 'Watch on YouTube'} class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text-primary)]">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
