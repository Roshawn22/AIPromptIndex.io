---
import LogoMark from './LogoMark.astro';
import bestofPages from '../../data/seo/bestof-pages.json';
import {
  DEFAULT_LOCALE,
  getCommon,
  getLocaleFromPath,
  getLocalizedPath,
  getLocalizedRoundups,
  getPilotPages,
  type SiteLocale,
} from '../../lib/localization';

interface Props {
  locale?: SiteLocale;
}

const locale = Astro.props.locale || getLocaleFromPath(Astro.url.pathname);
const common = getCommon(locale);
const footerCopy = common?.footer;

// A localized footer only links to pages that exist in that locale, plus the English-only
// pages it labels as such. The lists come from the locale's pilot pages, so a locale with a
// single collection gets a short footer rather than English links dressed up as local ones.
const localizedPages = locale === DEFAULT_LOCALE ? [] : Object.values(getPilotPages(locale));
const localizedHome = localizedPages.find((page) => page.type === 'home');
const localizedRoundups = locale === DEFAULT_LOCALE ? [] : getLocalizedRoundups(locale);
const localizedPrompts = localizedPages.filter((page) => page.type === 'prompt');
const localizedLink = (page: { sourcePath: string; title: string }) => ({
  href: getLocalizedPath(page.sourcePath, locale),
  label: page.title,
});
const toolCollectionSlugs = new Set(
  bestofPages.filter((page) => page.filter && 'tool' in page.filter).map((page) => page.slug),
);

const englishDirectoryLinks = [
  { href: '/prompts/', label: 'All Prompts' },
  { href: '/categories/writing/', label: 'Writing Prompts' },
  { href: '/categories/coding/', label: 'Coding Prompts' },
  { href: '/categories/marketing/', label: 'Marketing Prompts' },
  { href: '/categories/image-generation/', label: 'Image Prompts' },
  { href: '/categories/business/', label: 'Business Prompts' },
];
const directoryLinks = locale === DEFAULT_LOCALE
  ? englishDirectoryLinks
  : [
      ...(localizedHome && common ? [{ href: getLocalizedPath('/', locale), label: common.content.home }] : []),
      ...localizedRoundups.map(localizedLink),
    ];

const englishResourceLinks = [
  { href: '/guides/', label: 'Guides' },
  { href: '/blog/', label: 'Blog' },
  { href: '/submit/', label: 'Submit a Prompt' },
];
const resourceLinks = locale === DEFAULT_LOCALE
  ? englishResourceLinks
  : [
      ...localizedPrompts.map(localizedLink),
      { href: '/submit/', label: common?.header.submit || 'Submit a Prompt' },
    ];

const englishBestPromptsLinks = [
  { href: '/best/', label: 'All Collections' },
  { href: '/best/chatgpt-prompts/', label: 'Best ChatGPT Prompts' },
  { href: '/best/coding-prompts/', label: 'Best Coding Prompts' },
  { href: '/best/writing-prompts/', label: 'Best Writing Prompts' },
  { href: '/best/midjourney-prompts/', label: 'Best Midjourney Prompts' },
  { href: '/prompts/chatgpt/marketing/', label: 'ChatGPT Marketing Prompts' },
  { href: '/prompts/for/teachers/', label: 'AI Prompts for Teachers' },
  { href: '/best/dall-e-art-prompts/', label: 'DALL-E Prompts' },
  { href: '/best/prompt-templates/', label: 'Prompt Templates' },
  { href: '/prompts/cursor/coding/', label: 'Cursor Coding Prompts' },
];
const bestPromptsLinks = locale === DEFAULT_LOCALE
  ? englishBestPromptsLinks
  : localizedRoundups.map(localizedLink);

const englishToolLinks = [
  { href: '/tools/chatgpt/', label: 'ChatGPT Prompts' },
  { href: '/tools/claude/', label: 'Claude Prompts' },
  { href: '/tools/midjourney/', label: 'Midjourney Prompts' },
  { href: '/tools/gemini/', label: 'Gemini Prompts' },
  { href: '/tools/cursor/', label: 'Cursor Prompts' },
];
const toolLinks = locale === DEFAULT_LOCALE
  ? englishToolLinks
  : localizedRoundups.filter((page) => toolCollectionSlugs.has(page.sourceSlug)).map(localizedLink);

const communityLinks = [
  { href: 'https://www.skool.com/aifreedomlab', label: 'AI Freedom Lab', external: true },
  { href: 'https://www.youtube.com/@AIHeavyOfficial', label: 'AI Heavy YouTube', external: true },
  { href: 'https://aitoolindex.io', label: 'AIToolIndex.io', external: true },
];

const companyLinks = [
  { href: '/about/', label: footerCopy?.about || 'About' },
  { href: '/contact/', label: footerCopy?.contact || 'Contact' },
  { href: '/privacy/', label: footerCopy?.privacy || 'Privacy Policy' },
];

const columns = [
  { heading: footerCopy?.directory || 'Directory', links: directoryLinks },
  { heading: footerCopy?.resources || 'Resources', links: resourceLinks },
  { heading: footerCopy?.bestPrompts || 'Best Prompts', links: bestPromptsLinks },
  { heading: footerCopy?.byTool || 'By Tool', links: toolLinks },
  { heading: footerCopy?.community || 'Community', links: communityLinks },
  { heading: footerCopy?.company || 'Company', links: companyLinks },
].filter((column) => column.links.length > 0);
---


<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface-1)]">
  <div class="mx-auto max-w-7xl px-[var(--space-page)] py-16">
    <!-- Cross-promo -->
    <div class="mb-12 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface-2)] p-6 text-center">
      <p class="text-sm text-[var(--color-text-secondary)]">
        {footerCopy?.crossPromoPrefix || 'Looking for AI tools? Visit'}
        <a href="https://aitoolindex.io" target="_blank" rel="noopener noreferrer" class="font-[var(--font-display)] font-semibold text-[var(--color-accent)] hover:underline">
          AIToolIndex.io
        </a>
        {footerCopy?.crossPromoSuffix || '— The AI Tools Directory'}
      </p>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6">
      {columns.map((column) => (
        <div>
          <h2 class="mb-4 font-[var(--font-display)] text-xs font-semibold uppercase tracking-wider text-[var(--color-text-muted)]">
            {column.heading}
          </h2>
          <ul class="space-y-2.5">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link && link.external ? '_blank' : undefined}
                  rel={'external' in link && link.external ? 'noopener noreferrer' : undefined}
                  class="text-sm text-[var(--color-text-secondary)] transition-colors hover:text-[var(--color-text-primary)]"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[var(--color-border)] pt-8 sm:flex-row">
      <div class="flex items-center gap-2">
        <LogoMark size="sm" />
        <span class="font-[var(--font-display)] text-sm font-semibold text-[var(--color-text-primary)]">
          AIPromptIndex
        </span>
      </div>

      <p class="text-xs text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} AIPromptIndex. {footerCopy?.rights || 'All rights reserved.'}
      </p>

      <div class="flex items-center gap-3">
        <!-- YouTube -->
        <a href="https://youtube.com/@AIHeavyOfficial" target="_blank" rel="noopener noreferrer" aria-label={footerCopy?.watchYoutube || 'Watch on YouTube'} class="flex h-8 w-8 items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors hover:bg-[var(--color-surface-2)] hover:text-[var(--color-text-primary)]">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
